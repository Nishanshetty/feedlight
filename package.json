{
  "name": "feedlight",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:app": "tauri build",
    "lint": "oxlint",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint:rust": "cd src-tauri && cargo fmt --check && cargo clippy --lib --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/dompurify": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "dompurify": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.12.6",
    "@types/mozilla-readability": "^0.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
